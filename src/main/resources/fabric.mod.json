{
    "schemaVersion": 1,
    "id": "openstage",
    "version": "${version}",
    "name": "OpenStage",
    "description": "OpenStage is a powerful in-game animation studio for Minecraft which allows creating, posing, and animating characters directly in the world",
    "authors": [
        "ItzNoRiley"
    ],
    "contact": {
        "homepage": "https://github.com/itznoriley/OpenStage-code",
        "sources": "https://github.com/itznoriley/OpenStage-code",
        "issues": "https://github.com/itznoriley/OpenStage-code/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.donations": "https://www.donationalerts.com/r/itznoriley"
            }
        }
    },
    "license": "MIT",
    "icon": "assets/openstage/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.openstage.OpenStageMod"
        ],
        "client": [
            "net.openstage.client.OpenStageClient"
        ]
    },
    "mixins": [
        "openstage.mixins.json",
        {
            "config": "openstage.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~1.21.1",
        "java": ">=21",
        "fabric-api": "*"
    },
    "suggests": {
        "owo-lib": "*"
    }
}
